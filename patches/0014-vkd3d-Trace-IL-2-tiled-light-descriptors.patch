From 274f6f8e2d5b785fa871cedb0e3267e6a2af9abf Mon Sep 17 00:00:00 2001
From: Silv3rShi3ld <silv3rshi3ld@users.noreply.github.com>
Date: Sat, 8 Aug 2026 09:46:53 +0200
Subject: [PATCH] vkd3d: Trace IL-2 tiled-light descriptors

---
 libs/vkd3d/command.c       | 205 ++++++++++++++++++++++++
 libs/vkd3d/device.c        |  52 +++++-
 libs/vkd3d/resource.c      | 319 +++++++++++++++++++++++++++++++++++++
 libs/vkd3d/vkd3d_private.h |  49 ++++++
 4 files changed, 624 insertions(+), 1 deletion(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index f01de7db..83ab6d52 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -35,8 +35,11 @@
 #define VKD3D_IL2_LIGHT_READ_OP_BUDGET 2u
 #define VKD3D_IL2_LIGHT_POST_COUNT_DISPATCH_BUDGET 4u
 #define VKD3D_IL2_LIGHT_POST_COUNT_BARRIER_BUDGET 16u
+#define VKD3D_IL2_DESCRIPTOR_EVENT_LIMIT 20000u
 
 #define VKD3D_IL2_LIGHT_COMPUTE_LIGHTS_COUNT_HASH 0x651194bd0a21772eull
+#define VKD3D_IL2_DESCRIPTOR_PIXEL_MSP_HASH 0xdf0bd777fd1bb89dull
+#define VKD3D_IL2_DESCRIPTOR_PIXEL_MSS_HASH 0xa2d104d5c813322eull
 
 static pthread_once_t vkd3d_il2_menu_command_trace_once = PTHREAD_ONCE_INIT;
 static bool vkd3d_il2_menu_command_trace;
@@ -47,6 +50,7 @@ static uint32_t vkd3d_il2_menu_usage_event_count;
 static pthread_once_t vkd3d_il2_light_usage_trace_once = PTHREAD_ONCE_INIT;
 static bool vkd3d_il2_light_usage_trace;
 static uint32_t vkd3d_il2_light_usage_event_count;
+static uint32_t vkd3d_il2_descriptor_event_count;
 
 static void vkd3d_il2_menu_command_trace_init(void)
 {
@@ -602,6 +606,205 @@ static void vkd3d_il2_light_trace_copy(struct d3d12_command_list *list, const ch
                     src_resource->il2_light_trace_name : "-");
 }
 
+static bool vkd3d_il2_descriptor_trace_take(uint32_t *sequence)
+{
+    uint32_t value;
+
+    if (!vkd3d_il2_descriptor_trace_enabled())
+        return false;
+
+    value = vkd3d_atomic_uint32_increment(&vkd3d_il2_descriptor_event_count,
+            vkd3d_memory_order_relaxed);
+    *sequence = value;
+    if (value <= VKD3D_IL2_DESCRIPTOR_EVENT_LIMIT)
+        return true;
+
+    if (value == VKD3D_IL2_DESCRIPTOR_EVENT_LIMIT + 1)
+        INFO("IL2DESC draw events suppressed after limit=%u.\n", VKD3D_IL2_DESCRIPTOR_EVENT_LIMIT);
+    return false;
+}
+
+static const char *vkd3d_il2_descriptor_trace_type_name(uint32_t type)
+{
+    switch (type)
+    {
+        case VKD3D_IL2_DESCRIPTOR_TRACE_CBV:
+            return "cbv";
+        case VKD3D_IL2_DESCRIPTOR_TRACE_SRV:
+            return "srv";
+        case VKD3D_IL2_DESCRIPTOR_TRACE_UAV:
+            return "uav";
+        default:
+            return "unknown";
+    }
+}
+
+static uint64_t vkd3d_il2_descriptor_trace_pixel_hash(const struct d3d12_command_list *list)
+{
+    unsigned int i;
+
+    if (!list->state || !d3d12_pipeline_state_is_graphics(list->state))
+        return 0;
+
+    for (i = 0; i < list->state->graphics.stage_count; i++)
+        if (list->state->graphics.stages[i].stage == VK_SHADER_STAGE_FRAGMENT_BIT)
+            return list->state->graphics.code[i].meta.hash;
+
+    return 0;
+}
+
+static const struct vkd3d_shader_resource_binding *vkd3d_il2_descriptor_trace_find_binding(
+        const struct d3d12_root_signature *root_signature, uint32_t shader_register)
+{
+    const struct vkd3d_shader_resource_binding *binding;
+    uint32_t expected_flag;
+    unsigned int i, pass;
+
+    expected_flag = shader_register == 9 ?
+            VKD3D_SHADER_BINDING_FLAG_IMAGE : VKD3D_SHADER_BINDING_FLAG_BUFFER;
+
+    for (pass = 0; pass < 2; pass++)
+    {
+        for (i = 0; i < root_signature->binding_count; i++)
+        {
+            binding = &root_signature->bindings[i];
+            if (binding->type != VKD3D_SHADER_DESCRIPTOR_TYPE_SRV ||
+                    binding->register_space != 0 || shader_register < binding->register_index ||
+                    (binding->register_count != VKD3D_SHADER_DESCRIPTOR_RANGE_UNBOUNDED &&
+                    shader_register - binding->register_index >= binding->register_count) ||
+                    (binding->shader_visibility != VKD3D_SHADER_VISIBILITY_ALL &&
+                    binding->shader_visibility != VKD3D_SHADER_VISIBILITY_PIXEL))
+                continue;
+
+            if (!pass && !(binding->flags & expected_flag))
+                continue;
+            return binding;
+        }
+    }
+
+    return NULL;
+}
+
+static bool vkd3d_il2_descriptor_trace_find_root_parameter(
+        const struct d3d12_root_signature *root_signature, uint32_t table_index,
+        uint32_t *root_parameter_index)
+{
+    unsigned int i;
+
+    for (i = 0; i < root_signature->parameter_count; i++)
+    {
+        if (root_signature->parameters[i].parameter_type == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE &&
+                root_signature->parameters[i].descriptor_table.table_index == table_index)
+        {
+            *root_parameter_index = i;
+            return true;
+        }
+    }
+
+    return false;
+}
+
+static void vkd3d_il2_descriptor_trace_register(struct d3d12_command_list *list,
+        const char *op, uint64_t ps_hash, uint32_t shader_register)
+{
+    struct vkd3d_il2_descriptor_trace_entry entry;
+    const struct vkd3d_shader_resource_binding *binding;
+    const struct d3d12_root_signature *root_signature;
+    struct d3d12_descriptor_heap *heap;
+    uint64_t descriptor_offset;
+    uint32_t root_parameter_index, table_base, sequence;
+
+    if (!vkd3d_il2_descriptor_trace_take(&sequence))
+        return;
+
+    root_signature = list->graphics_bindings.root_signature;
+    if (!root_signature)
+    {
+        INFO("IL2DESC sequence=%u op=%s list=%p ps=%016"PRIx64
+                " register=t%u status=no_root_signature.\n",
+                sequence, op, list, ps_hash, shader_register);
+        return;
+    }
+
+    if (!(binding = vkd3d_il2_descriptor_trace_find_binding(root_signature, shader_register)))
+    {
+        INFO("IL2DESC sequence=%u op=%s list=%p ps=%016"PRIx64
+                " register=t%u status=no_binding root_signature=%016"PRIx64".\n",
+                sequence, op, list, ps_hash, shader_register,
+                root_signature->layout_compatibility_hash);
+        return;
+    }
+
+    if (!vkd3d_il2_descriptor_trace_find_root_parameter(root_signature,
+            binding->descriptor_table, &root_parameter_index))
+    {
+        INFO("IL2DESC sequence=%u op=%s list=%p ps=%016"PRIx64
+                " register=t%u status=no_root_parameter table=%u.\n",
+                sequence, op, list, ps_hash, shader_register, binding->descriptor_table);
+        return;
+    }
+
+    table_base = list->graphics_bindings.descriptor_tables[root_parameter_index];
+    descriptor_offset = (uint64_t)table_base + binding->descriptor_offset +
+            shader_register - binding->register_index;
+    heap = list->descriptor_heap.buffers.resource.heap;
+    if (!heap || descriptor_offset >= heap->desc.NumDescriptors)
+    {
+        INFO("IL2DESC sequence=%u op=%s list=%p ps=%016"PRIx64
+                " register=t%u status=heap_oob root_parameter=%u table=%u table_base=%u "
+                "range_base=%u range_offset=%u heap_offset=%"PRIu64" heap_count=%u.\n",
+                sequence, op, list, ps_hash, shader_register, root_parameter_index,
+                binding->descriptor_table, table_base, binding->register_index,
+                binding->descriptor_offset, descriptor_offset,
+                heap ? heap->desc.NumDescriptors : 0);
+        return;
+    }
+
+    if (!vkd3d_il2_descriptor_trace_snapshot(heap, descriptor_offset, &entry))
+    {
+        INFO("IL2DESC sequence=%u op=%s list=%p ps=%016"PRIx64
+                " register=t%u status=no_sidecar root_parameter=%u table=%u "
+                "table_base=%u heap_offset=%"PRIu64".\n",
+                sequence, op, list, ps_hash, shader_register, root_parameter_index,
+                binding->descriptor_table, table_base, descriptor_offset);
+        return;
+    }
+
+    INFO("IL2DESC sequence=%u op=%s list=%p ps=%016"PRIx64
+            " root_signature=%016"PRIx64" register=t%u status=resolved "
+            "root_parameter=%u table=%u table_base=%u range_base=%u range_count=%u "
+            "range_offset=%u binding_flags=%#x heap_offset=%"PRIu64" heap_count=%u "
+            "serial=%u type=%s cookie=%u resource_dimension=%u resource_width=%"PRIu64" "
+            "resource_height=%u resource_depth_or_layers=%u resource_format=%u "
+            "view_dimension=%u view_format=%u buffer_first=%"PRIu64" "
+            "buffer_elements=%u buffer_stride=%u buffer_flags=%#x.\n",
+            sequence, op, list, ps_hash, root_signature->layout_compatibility_hash,
+            shader_register, root_parameter_index, binding->descriptor_table, table_base,
+            binding->register_index, binding->register_count, binding->descriptor_offset,
+            binding->flags, descriptor_offset, heap->desc.NumDescriptors,
+            entry.serial, vkd3d_il2_descriptor_trace_type_name(entry.type),
+            entry.resource_cookie, entry.resource_dimension, entry.resource_width,
+            entry.resource_height, entry.resource_depth_or_layers, entry.resource_format,
+            entry.view_dimension, entry.view_format, entry.buffer_first_element,
+            entry.buffer_num_elements, entry.buffer_structure_stride, entry.buffer_flags);
+}
+
+static void vkd3d_il2_descriptor_trace_draw(struct d3d12_command_list *list, const char *op)
+{
+    uint64_t ps_hash;
+
+    if (!vkd3d_il2_descriptor_trace_enabled())
+        return;
+
+    ps_hash = vkd3d_il2_descriptor_trace_pixel_hash(list);
+    if (ps_hash != VKD3D_IL2_DESCRIPTOR_PIXEL_MSP_HASH &&
+            ps_hash != VKD3D_IL2_DESCRIPTOR_PIXEL_MSS_HASH)
+        return;
+
+    vkd3d_il2_descriptor_trace_register(list, op, ps_hash, 9);
+    vkd3d_il2_descriptor_trace_register(list, op, ps_hash, 10);
+}
+
 static HRESULT d3d12_fence_signal(struct d3d12_fence *fence, struct vkd3d_fence_worker *worker, uint64_t value);
 static void d3d12_command_queue_add_submission(struct d3d12_command_queue *queue,
         const struct d3d12_command_queue_submission *sub);
@@ -9863,6 +10066,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_DrawInstanced(d3d12_command_lis
 
     vkd3d_il2_menu_trace_draw(list, "draw", vertex_count_per_instance, instance_count);
     vkd3d_il2_light_trace_draw(list, "draw", vertex_count_per_instance, instance_count);
+    vkd3d_il2_descriptor_trace_draw(list, "draw");
 
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_HIGH;
 
@@ -9939,6 +10143,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_DrawIndexedInstanced(d3d12_comm
 
     vkd3d_il2_menu_trace_draw(list, "draw_indexed", index_count_per_instance, instance_count);
     vkd3d_il2_light_trace_draw(list, "draw_indexed", index_count_per_instance, instance_count);
+    vkd3d_il2_descriptor_trace_draw(list, "draw_indexed");
 
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_HIGH;
 
