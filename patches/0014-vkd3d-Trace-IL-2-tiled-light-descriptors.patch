diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 6175467e..3240fd9c 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -41,6 +41,310 @@ static uint32_t vkd3d_il2_menu_resource_name_count;
 static pthread_once_t vkd3d_il2_light_resource_trace_once = PTHREAD_ONCE_INIT;
 static bool vkd3d_il2_light_resource_trace;
