+static uint32_t vkd3d_il2_descriptor_trace_serial;
+static pthread_mutex_t vkd3d_il2_descriptor_trace_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct list vkd3d_il2_descriptor_trace_heaps = LIST_INIT(vkd3d_il2_descriptor_trace_heaps);
+
+static void vkd3d_il2_descriptor_trace_init(void)
+{
+    char value[16];
+
+    vkd3d_il2_descriptor_trace = vkd3d_get_env_var("VKD3D_IL2_DESCRIPTOR_TRACE", value, sizeof(value)) &&
+            strcmp(value, "0") != 0;
+    if (vkd3d_il2_descriptor_trace)
+        INFO("IL2DESC descriptor sidecar trace enabled.\n");
+}
+
+bool vkd3d_il2_descriptor_trace_enabled(void)
+{
+    pthread_once(&vkd3d_il2_descriptor_trace_once, vkd3d_il2_descriptor_trace_init);
+    return vkd3d_il2_descriptor_trace;
+}
+
+static bool vkd3d_il2_descriptor_trace_find_entry_locked(struct d3d12_device *device,
+        D3D12_CPU_DESCRIPTOR_HANDLE descriptor, struct d3d12_descriptor_heap **out_heap,
+        uint32_t *out_offset)
+{
+    struct d3d12_descriptor_heap *heap;
+    uintptr_t base, delta, span;
+    unsigned int increment;
+
+    LIST_FOR_EACH_ENTRY(heap, &vkd3d_il2_descriptor_trace_heaps,
+            struct d3d12_descriptor_heap, il2_descriptor_trace_link)
+    {
+        if (heap->device != device || !heap->il2_descriptor_trace_entries)
+            continue;
+
+        increment = d3d12_device_get_descriptor_handle_increment_size(device, heap->desc.Type);
+        base = heap->cpu_va.ptr;
+        if (descriptor.ptr < base || !increment)
+            continue;
+
+        delta = descriptor.ptr - base;
+        span = (uintptr_t)increment * heap->desc.NumDescriptors;
+        if (delta >= span || delta % increment)
+            continue;
+
+        *out_heap = heap;
+        *out_offset = delta / increment;
+        return true;
+    }
+
+    return false;
+}
+
+static void vkd3d_il2_descriptor_trace_set_resource(
+        struct vkd3d_il2_descriptor_trace_entry *entry,
+        const struct d3d12_resource *resource)
+{
+    if (!resource)
+        return;
+
+    entry->resource_cookie = resource->res.cookie.index;
+    entry->resource_dimension = resource->desc.Dimension;
+    entry->resource_width = resource->desc.Width;
+    entry->resource_height = resource->desc.Height;
+    entry->resource_depth_or_layers = resource->desc.DepthOrArraySize;
+    entry->resource_format = resource->desc.Format;
+}
+
+static void vkd3d_il2_descriptor_trace_store(struct d3d12_device *device,
+        D3D12_CPU_DESCRIPTOR_HANDLE descriptor,
+        const struct vkd3d_il2_descriptor_trace_entry *source)
+{
+    struct vkd3d_il2_descriptor_trace_entry entry = *source;
+    struct d3d12_descriptor_heap *heap;
+    uint32_t offset;
+
+    if (!vkd3d_il2_descriptor_trace_enabled())
+        return;
+
+    entry.serial = vkd3d_atomic_uint32_increment(&vkd3d_il2_descriptor_trace_serial,
+            vkd3d_memory_order_relaxed);
+
+    pthread_mutex_lock(&vkd3d_il2_descriptor_trace_mutex);
+    if (vkd3d_il2_descriptor_trace_find_entry_locked(device, descriptor, &heap, &offset))
+        heap->il2_descriptor_trace_entries[offset] = entry;
+    pthread_mutex_unlock(&vkd3d_il2_descriptor_trace_mutex);
+}
+
+void vkd3d_il2_descriptor_trace_write_cbv(struct d3d12_device *device,
+        D3D12_CPU_DESCRIPTOR_HANDLE descriptor, const D3D12_CONSTANT_BUFFER_VIEW_DESC *desc)
+{
+    struct vkd3d_il2_descriptor_trace_entry entry;
+    const struct vkd3d_unique_resource *resource;
+
+    memset(&entry, 0, sizeof(entry));
+    entry.type = VKD3D_IL2_DESCRIPTOR_TRACE_CBV;
+    entry.resource_dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+
+    if (desc && desc->BufferLocation)
+    {
+        resource = vkd3d_va_map_deref(&device->memory_allocator.va_map, desc->BufferLocation);
+        if (resource)
+        {
+            entry.resource_cookie = resource->cookie.index;
+            entry.resource_width = resource->size;
+            entry.buffer_first_element = desc->BufferLocation - resource->va;
+        }
+        entry.buffer_num_elements = desc->SizeInBytes;
+    }
+
+    vkd3d_il2_descriptor_trace_store(device, descriptor, &entry);
+}
+
+void vkd3d_il2_descriptor_trace_write_srv(struct d3d12_device *device,
+        D3D12_CPU_DESCRIPTOR_HANDLE descriptor, const struct d3d12_resource *resource,
+        const D3D12_SHADER_RESOURCE_VIEW_DESC *desc)
+{
+    struct vkd3d_il2_descriptor_trace_entry entry;
+
+    memset(&entry, 0, sizeof(entry));
+    entry.type = VKD3D_IL2_DESCRIPTOR_TRACE_SRV;
+    vkd3d_il2_descriptor_trace_set_resource(&entry, resource);
+
+    if (desc)
+    {
+        entry.view_dimension = desc->ViewDimension;
+        entry.view_format = desc->Format;
+        if (desc->ViewDimension == D3D12_SRV_DIMENSION_BUFFER)
+        {
+            entry.buffer_first_element = desc->Buffer.FirstElement;
+            entry.buffer_num_elements = desc->Buffer.NumElements;
+            entry.buffer_structure_stride = desc->Buffer.StructureByteStride;
+            entry.buffer_flags = desc->Buffer.Flags;
+        }
+        else if (desc->ViewDimension == D3D12_SRV_DIMENSION_BUFFER_BYTE_OFFSET)
+        {
+            entry.buffer_first_element = desc->BufferByteOffset.Offset;
+            entry.buffer_num_elements = desc->BufferByteOffset.Size;
+            entry.buffer_structure_stride = desc->BufferByteOffset.StructureByteStride;
+            entry.buffer_flags = desc->BufferByteOffset.Flags;
+        }
+    }
+
+    vkd3d_il2_descriptor_trace_store(device, descriptor, &entry);
+}
+
+void vkd3d_il2_descriptor_trace_write_uav(struct d3d12_device *device,
+        D3D12_CPU_DESCRIPTOR_HANDLE descriptor, const struct d3d12_resource *resource,
+        const D3D12_UNORDERED_ACCESS_VIEW_DESC *desc)
+{
+    struct vkd3d_il2_descriptor_trace_entry entry;
+
+    memset(&entry, 0, sizeof(entry));
+    entry.type = VKD3D_IL2_DESCRIPTOR_TRACE_UAV;
+    vkd3d_il2_descriptor_trace_set_resource(&entry, resource);
+
+    if (desc)
+    {
+        entry.view_dimension = desc->ViewDimension;
+        entry.view_format = desc->Format;
+        if (desc->ViewDimension == D3D12_UAV_DIMENSION_BUFFER)
+        {
+            entry.buffer_first_element = desc->Buffer.FirstElement;
+            entry.buffer_num_elements = desc->Buffer.NumElements;
+            entry.buffer_structure_stride = desc->Buffer.StructureByteStride;
+            entry.buffer_flags = desc->Buffer.Flags;
+        }
+        else if (desc->ViewDimension == D3D12_UAV_DIMENSION_BUFFER_BYTE_OFFSET)
+        {
+            entry.buffer_first_element = desc->BufferByteOffset.Offset;
+            entry.buffer_num_elements = desc->BufferByteOffset.Size;
+            entry.buffer_structure_stride = desc->BufferByteOffset.StructureByteStride;
+            entry.buffer_flags = desc->BufferByteOffset.Flags;
+        }
+    }
+
+    vkd3d_il2_descriptor_trace_store(device, descriptor, &entry);
+}
+
+void vkd3d_il2_descriptor_trace_copy_simple(struct d3d12_device *device,
+        D3D12_CPU_DESCRIPTOR_HANDLE dst, D3D12_CPU_DESCRIPTOR_HANDLE src,
+        UINT descriptor_count, D3D12_DESCRIPTOR_HEAP_TYPE descriptor_heap_type)
+{
+    struct d3d12_descriptor_heap *dst_heap, *src_heap;
+    uint32_t dst_offset, src_offset;
+
+    if (!vkd3d_il2_descriptor_trace_enabled() ||
+            descriptor_heap_type != D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV || !descriptor_count)
+        return;
+
+    pthread_mutex_lock(&vkd3d_il2_descriptor_trace_mutex);
+    if (vkd3d_il2_descriptor_trace_find_entry_locked(device, dst, &dst_heap, &dst_offset) &&
+            vkd3d_il2_descriptor_trace_find_entry_locked(device, src, &src_heap, &src_offset) &&
+            descriptor_count <= dst_heap->desc.NumDescriptors - dst_offset &&
+            descriptor_count <= src_heap->desc.NumDescriptors - src_offset)
+    {
+        memmove(&dst_heap->il2_descriptor_trace_entries[dst_offset],
+                &src_heap->il2_descriptor_trace_entries[src_offset],
+                descriptor_count * sizeof(*dst_heap->il2_descriptor_trace_entries));
+    }
+    pthread_mutex_unlock(&vkd3d_il2_descriptor_trace_mutex);
+}
+
+void vkd3d_il2_descriptor_trace_copy_ranges(struct d3d12_device *device,
+        UINT dst_range_count, const D3D12_CPU_DESCRIPTOR_HANDLE *dst_range_offsets,
+        const UINT *dst_range_sizes, UINT src_range_count,
+        const D3D12_CPU_DESCRIPTOR_HANDLE *src_range_offsets, const UINT *src_range_sizes,
+        D3D12_DESCRIPTOR_HEAP_TYPE descriptor_heap_type)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE dst, src;
+    unsigned int dst_range_index = 0, src_range_index = 0;
+    unsigned int dst_index = 0, src_index = 0;
+    unsigned int dst_range_size, src_range_size, copy_count, increment;
+
+    if (!vkd3d_il2_descriptor_trace_enabled() ||
+            descriptor_heap_type != D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV)
+        return;
+
+    increment = d3d12_device_get_descriptor_handle_increment_size(device, descriptor_heap_type);
+    while (dst_range_index < dst_range_count && src_range_index < src_range_count)
+    {
+        dst_range_size = dst_range_sizes ? dst_range_sizes[dst_range_index] : 1;
+        src_range_size = src_range_sizes ? src_range_sizes[src_range_index] : 1;
+        copy_count = min(dst_range_size - dst_index, src_range_size - src_index);
+
+        dst.ptr = dst_range_offsets[dst_range_index].ptr + (uintptr_t)increment * dst_index;
+        src.ptr = src_range_offsets[src_range_index].ptr + (uintptr_t)increment * src_index;
+        vkd3d_il2_descriptor_trace_copy_simple(device, dst, src, copy_count, descriptor_heap_type);
+
+        dst_index += copy_count;
+        src_index += copy_count;
+        if (dst_index == dst_range_size)
+        {
+            dst_range_index++;
+            dst_index = 0;
+        }
+        if (src_index == src_range_size)
+        {
+            src_range_index++;
+            src_index = 0;
+        }
+    }
+}
+
+bool vkd3d_il2_descriptor_trace_snapshot(struct d3d12_descriptor_heap *heap,
+        uint32_t offset, struct vkd3d_il2_descriptor_trace_entry *entry)
+{
+    bool valid = false;
+
+    if (!vkd3d_il2_descriptor_trace_enabled())
+        return false;
+
+    pthread_mutex_lock(&vkd3d_il2_descriptor_trace_mutex);
+    if (heap && heap->il2_descriptor_trace_registered &&
+            offset < heap->desc.NumDescriptors)
+    {
+        *entry = heap->il2_descriptor_trace_entries[offset];
+        valid = true;
+    }
+    pthread_mutex_unlock(&vkd3d_il2_descriptor_trace_mutex);
+    return valid;
+}
+
+static void vkd3d_il2_descriptor_trace_register_heap(struct d3d12_descriptor_heap *heap)
+{
+    size_t entry_count;
+
+    if (!vkd3d_il2_descriptor_trace_enabled() ||
+            heap->desc.Type != D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV)
+        return;
+
+    entry_count = heap->desc.NumDescriptors;
+    if (!(heap->il2_descriptor_trace_entries = vkd3d_calloc(entry_count,
+            sizeof(*heap->il2_descriptor_trace_entries))))
+    {
+        WARN("IL2DESC failed to allocate sidecar for %zu descriptors.\n", entry_count);
+        return;
+    }
+
+    pthread_mutex_lock(&vkd3d_il2_descriptor_trace_mutex);
+    list_add_tail(&vkd3d_il2_descriptor_trace_heaps, &heap->il2_descriptor_trace_link);
+    heap->il2_descriptor_trace_registered = true;
+    pthread_mutex_unlock(&vkd3d_il2_descriptor_trace_mutex);
+
+    INFO("IL2DESC heap=%p descriptors=%u shader_visible=%u increment=%u.\n",
+            heap, heap->desc.NumDescriptors,
+            !!(heap->desc.Flags & D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE),
+            d3d12_device_get_descriptor_handle_increment_size(heap->device, heap->desc.Type));
+}
+
+static void vkd3d_il2_descriptor_trace_unregister_heap(struct d3d12_descriptor_heap *heap)
+{
+    pthread_mutex_lock(&vkd3d_il2_descriptor_trace_mutex);
+    if (heap->il2_descriptor_trace_registered)
+    {
+        list_remove(&heap->il2_descriptor_trace_link);
+        heap->il2_descriptor_trace_registered = false;
+    }
+    pthread_mutex_unlock(&vkd3d_il2_descriptor_trace_mutex);
+
+    vkd3d_free(heap->il2_descriptor_trace_entries);
+    heap->il2_descriptor_trace_entries = NULL;
+}
 
