From 376652dc46fc323d2d2eb59ae8bd0ebd6cf3d189 Mon Sep 17 00:00:00 2001
From: Silv3rShi3ld <silv3rshi3ld@users.noreply.github.com>
Date: Fri, 7 Aug 2026 10:07:41 +0200
Subject: [PATCH] vkd3d: Add focused IL-2 baked-cache telemetry

---
 libs/vkd3d/command.c       | 109 +++++++++++++++++++++++++++++++++++++
 libs/vkd3d/resource.c      |  96 ++++++++++++++++++++++++++++++++
 libs/vkd3d/vkd3d_private.h |  14 +++++
 3 files changed, 219 insertions(+)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 5062c480..8a6da1bb 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -10836,7 +10836,9 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyTextureRegion(d3d12_command
         const D3D12_TEXTURE_COPY_LOCATION *src, const D3D12_BOX *src_box)
 {
     struct d3d12_command_list *list = impl_from_ID3D12GraphicsCommandList(iface);
+    struct d3d12_resource *dst_resource, *src_resource;
     struct vkd3d_image_copy_info copy_info;
+    uint32_t sequence;
     VkImageCopy2 *fused_aspect_info;
     VkImageAspectFlags fused_aspect;
     bool alias;
@@ -10857,6 +10859,56 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyTextureRegion(d3d12_command
     if (!d3d12_command_list_init_copy_texture_region(list, dst, dst_x, dst_y, dst_z, src, src_box, &copy_info))
         return;
 
+    dst_resource = impl_from_ID3D12Resource(dst->pResource);
+    src_resource = impl_from_ID3D12Resource(src->pResource);
+
+    if ((vkd3d_il2_baked_cache_trace_resource(dst_resource) ||
+            vkd3d_il2_baked_cache_trace_resource(src_resource)) &&
+            vkd3d_il2_baked_cache_trace_take(VKD3D_IL2_BAKED_CACHE_TRACE_COPY, &sequence))
+    {
+        if (copy_info.batch_type == VKD3D_BATCH_TYPE_COPY_IMAGE)
+        {
+            INFO("IL2CACHE copy_image seq=%u list_type=%u src_cookie=%u dst_cookie=%u"
+                    " src_format=%#x dst_format=%#x src_location=%u dst_location=%u"
+                    " src_subresource=%u dst_subresource=%u extent=%ux%ux%u"
+                    " src_offset=%d,%d,%d dst_offset=%d,%d,%d"
+                    " full_subresource=%u full_resource=%u overlap=%u.\n",
+                    sequence, list->type, src_resource->res.cookie.index, dst_resource->res.cookie.index,
+                    src_resource->desc.Format, dst_resource->desc.Format, src->Type, dst->Type,
+                    src->SubresourceIndex, dst->SubresourceIndex,
+                    copy_info.copy.image.extent.width, copy_info.copy.image.extent.height,
+                    copy_info.copy.image.extent.depth,
+                    copy_info.copy.image.srcOffset.x, copy_info.copy.image.srcOffset.y,
+                    copy_info.copy.image.srcOffset.z, copy_info.copy.image.dstOffset.x,
+                    copy_info.copy.image.dstOffset.y, copy_info.copy.image.dstOffset.z,
+                    copy_info.writes_full_subresource, copy_info.writes_full_resource,
+                    copy_info.overlapping_subresource);
+        }
+        else
+        {
+            INFO("IL2CACHE copy_buffer_image seq=%u batch=%u list_type=%u src_cookie=%u dst_cookie=%u"
+                    " src_format=%#x dst_format=%#x src_location=%u dst_location=%u"
+                    " src_subresource=%u dst_subresource=%u extent=%ux%ux%u image_offset=%d,%d,%d"
+                    " buffer_offset=%"PRIu64" row_length=%u image_height=%u footprint_size=%"PRIu64
+                    " full_subresource=%u full_resource=%u.\n",
+                    sequence, copy_info.batch_type, list->type,
+                    src_resource->res.cookie.index, dst_resource->res.cookie.index,
+                    src_resource->desc.Format, dst_resource->desc.Format, src->Type, dst->Type,
+                    src->SubresourceIndex, dst->SubresourceIndex,
+                    copy_info.copy.buffer_image.imageExtent.width,
+                    copy_info.copy.buffer_image.imageExtent.height,
+                    copy_info.copy.buffer_image.imageExtent.depth,
+                    copy_info.copy.buffer_image.imageOffset.x,
+                    copy_info.copy.buffer_image.imageOffset.y,
+                    copy_info.copy.buffer_image.imageOffset.z,
+                    copy_info.copy.buffer_image.bufferOffset,
+                    copy_info.copy.buffer_image.bufferRowLength,
+                    copy_info.copy.buffer_image.bufferImageHeight,
+                    copy_info.buffer_footprint_size, copy_info.writes_full_subresource,
+                    copy_info.writes_full_resource);
+        }
+    }
+
     d3d12_command_list_ensure_transfer_batch(list, copy_info.batch_type);
 
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_LOW;
@@ -10954,6 +11006,24 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyResource(d3d12_command_list
     dst_resource = impl_from_ID3D12Resource(dst);
     src_resource = impl_from_ID3D12Resource(src);
 
+    if ((vkd3d_il2_baked_cache_trace_resource(dst_resource) ||
+            vkd3d_il2_baked_cache_trace_resource(src_resource)))
+    {
+        uint32_t sequence;
+
+        if (vkd3d_il2_baked_cache_trace_take(VKD3D_IL2_BAKED_CACHE_TRACE_COPY, &sequence))
+        {
+            INFO("IL2CACHE copy_resource seq=%u list_type=%u src_cookie=%u dst_cookie=%u"
+                    " src_format=%#x dst_format=%#x src_extent=%"PRIu64"x%ux%u"
+                    " dst_extent=%"PRIu64"x%ux%u src_mips=%u dst_mips=%u.\n",
+                    sequence, list->type, src_resource->res.cookie.index, dst_resource->res.cookie.index,
+                    src_resource->desc.Format, dst_resource->desc.Format,
+                    src_resource->desc.Width, src_resource->desc.Height, src_resource->desc.DepthOrArraySize,
+                    dst_resource->desc.Width, dst_resource->desc.Height, dst_resource->desc.DepthOrArraySize,
+                    src_resource->desc.MipLevels, dst_resource->desc.MipLevels);
+        }
+    }
+
     if (list->type == D3D12_COMMAND_LIST_TYPE_COPY)
     {
         if (!(dst_resource->flags & VKD3D_RESOURCE_COPY_QUEUE_COMPATIBLE) ||
@@ -13680,6 +13750,25 @@ static void STDMETHODCALLTYPE d3d12_command_list_ResourceBarrier(d3d12_command_l
                 {
                     VkImageMemoryBarrier2 vk_transition;
                     new_layout = vk_image_layout_from_d3d12_resource_state(list, preserve_resource, transition->StateAfter);
+
+                    if (vkd3d_il2_baked_cache_trace_resource(preserve_resource))
+                    {
+                        uint32_t sequence;
+
+                        if (vkd3d_il2_baked_cache_trace_take(VKD3D_IL2_BAKED_CACHE_TRACE_BARRIER, &sequence))
+                        {
+                            INFO("IL2CACHE barrier seq=%u list_type=%u cookie=%u format=%#x flags=%#x"
+                                    " subresource=%u before=%#x after=%#x old_layout=%u new_layout=%u"
+                                    " src_stage=%"PRIu64" src_access=%"PRIu64
+                                    " dst_stage=%"PRIu64" dst_access=%"PRIu64".\n",
+                                    sequence, list->type, preserve_resource->res.cookie.index,
+                                    preserve_resource->desc.Format, current->Flags, transition->Subresource,
+                                    transition->StateBefore, transition->StateAfter, old_layout, new_layout,
+                                    transition_src_stage_mask, transition_src_access,
+                                    transition_dst_stage_mask, transition_dst_access);
+                        }
+                    }
+
                     vk_image_memory_barrier_for_transition(&vk_transition,
                             preserve_resource,
                             transition->Subresource, old_layout, new_layout,
@@ -21674,6 +21763,26 @@ static void d3d12_command_list_process_enhanced_barrier_texture(struct d3d12_com
         return;
     }
 
+    if (vkd3d_il2_baked_cache_trace_resource(resource))
+    {
+        uint32_t sequence;
+
+        if (vkd3d_il2_baked_cache_trace_take(VKD3D_IL2_BAKED_CACHE_TRACE_BARRIER, &sequence))
+        {
+            INFO("IL2CACHE enhanced_barrier seq=%u list_type=%u cookie=%u format=%#x flags=%#x"
+                    " sync_before=%#x sync_after=%#x access_before=%#x access_after=%#x"
+                    " layout_before=%u layout_after=%u first_mip=%u mip_count=%u"
+                    " first_layer=%u layer_count=%u first_plane=%u plane_count=%u.\n",
+                    sequence, list->type, resource->res.cookie.index, resource->desc.Format,
+                    barrier->Flags, barrier->SyncBefore, barrier->SyncAfter,
+                    barrier->AccessBefore, barrier->AccessAfter, barrier->LayoutBefore,
+                    barrier->LayoutAfter, barrier->Subresources.IndexOrFirstMipLevel,
+                    barrier->Subresources.NumMipLevels, barrier->Subresources.FirstArraySlice,
+                    barrier->Subresources.NumArraySlices, barrier->Subresources.FirstPlane,
+                    barrier->Subresources.NumPlanes);
+        }
+    }
+
     if (VKD3D_CONFIG_FLAG_IS_SET(DEBUG_UTILS))
     {
         d3d12_command_list_debug_mark_label_printf(list, list->cmd.vk_command_buffer,
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 78db89c0..1bde2051 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -33,6 +33,74 @@
 
 static UINT global_cookie_counter;
 static UINT global_cookie_va_timestamp;
+static pthread_once_t il2_baked_cache_trace_once = PTHREAD_ONCE_INIT;
+static bool il2_baked_cache_trace;
+static uint32_t il2_baked_cache_trace_counters[VKD3D_IL2_BAKED_CACHE_TRACE_EVENT_COUNT];
+static const uint32_t il2_baked_cache_trace_limits[VKD3D_IL2_BAKED_CACHE_TRACE_EVENT_COUNT] =
+{
+    1024, 4096, 20000, 20000, 1024,
+};
+
+static void vkd3d_il2_baked_cache_trace_init(void)
+{
+    char value[16];
+
+    il2_baked_cache_trace = vkd3d_get_env_var("VKD3D_IL2_BAKED_CACHE_TRACE", value, sizeof(value)) &&
+            strcmp(value, "0") != 0;
+    if (il2_baked_cache_trace)
+        INFO("IL2CACHE enabled: trace-only 2048x2048 one-mip baked-cache telemetry.\n");
+}
+
+bool vkd3d_il2_baked_cache_trace_enabled(void)
+{
+    pthread_once(&il2_baked_cache_trace_once, vkd3d_il2_baked_cache_trace_init);
+    return il2_baked_cache_trace;
+}
+
+bool vkd3d_il2_baked_cache_trace_take(enum vkd3d_il2_baked_cache_trace_event event, uint32_t *sequence)
+{
+    uint32_t value;
+
+    if (!vkd3d_il2_baked_cache_trace_enabled() || event >= VKD3D_IL2_BAKED_CACHE_TRACE_EVENT_COUNT)
+        return false;
+
+    value = vkd3d_atomic_uint32_increment(&il2_baked_cache_trace_counters[event], vkd3d_memory_order_relaxed);
+    *sequence = value;
+
+    if (value <= il2_baked_cache_trace_limits[event])
+        return true;
+
+    if (value == il2_baked_cache_trace_limits[event] + 1)
+        INFO("IL2CACHE suppressed event=%u after limit=%u.\n", event, il2_baked_cache_trace_limits[event]);
+
+    return false;
+}
+
+bool vkd3d_il2_baked_cache_trace_resource(const struct d3d12_resource *resource)
+{
+    return resource && resource->desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+            resource->desc.Width == 2048 && resource->desc.Height == 2048 &&
+            resource->desc.DepthOrArraySize == 1 && resource->desc.MipLevels == 1 &&
+            resource->desc.SampleDesc.Count == 1;
+}
+
+static void vkd3d_il2_baked_cache_trace_create(const char *allocation,
+        const struct d3d12_resource *resource, uint64_t heap_offset)
+{
+    uint32_t sequence;
+
+    if (!vkd3d_il2_baked_cache_trace_resource(resource) ||
+            !vkd3d_il2_baked_cache_trace_take(VKD3D_IL2_BAKED_CACHE_TRACE_CREATE, &sequence))
+        return;
+
+    INFO("IL2CACHE create seq=%u cookie=%u allocation=%s format=%#x resource_flags=%#x"
+            " internal_flags=%#x heap_type=%u heap_flags=%#x initial_state=%#x"
+            " common_layout=%u heap_offset=%"PRIu64" memory_offset=%"PRIu64" memory_size=%"PRIu64".\n",
+            sequence, resource->res.cookie.index, allocation, resource->desc.Format,
+            resource->desc.Flags, resource->flags, resource->heap_properties.Type,
+            resource->heap_flags, resource->initial_state, resource->common_layout,
+            heap_offset, resource->mem.offset, resource->mem.resource.size);
+}
 
 static bool d3d12_resource_supports_small_resource_alignment(const D3D12_RESOURCE_DESC1 *desc,
         const struct vkd3d_format *format);
@@ -3973,6 +4041,15 @@ void d3d12_resource_decref_retained(struct d3d12_resource *resource)
 static void d3d12_resource_destroy(struct d3d12_resource *resource, struct d3d12_device *device)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    uint32_t sequence;
+
+    if (vkd3d_il2_baked_cache_trace_resource(resource) &&
+            vkd3d_il2_baked_cache_trace_take(VKD3D_IL2_BAKED_CACHE_TRACE_DESTROY, &sequence))
+    {
+        INFO("IL2CACHE destroy seq=%u cookie=%u format=%#x resource_flags=%#x internal_flags=%#x.\n",
+                sequence, resource->res.cookie.index, resource->desc.Format,
+                resource->desc.Flags, resource->flags);
+    }
 
     if (resource->flags & VKD3D_RESOURCE_RESERVED)
         d3d12_resource_wait_for_sparse_init(resource);
@@ -4545,6 +4622,7 @@ HRESULT d3d12_resource_create_committed(struct d3d12_device *device, const D3D12
     vkd3d_queue_timeline_trace_register_instantaneous(&device->queue_timeline_trace,
             VKD3D_QUEUE_TIMELINE_TRACE_STATE_TYPE_COMMITTED_RESOURCE_ALLOCATION, object->res.cookie.index);
 
+    vkd3d_il2_baked_cache_trace_create("committed", object, 0);
     *resource = object;
     return S_OK;
 
@@ -4783,6 +4861,7 @@ HRESULT d3d12_resource_create_placed(struct d3d12_device *device, const D3D12_RE
         vkd3d_breadcrumb_tracer_register_placed_resource(heap, object, heap_offset, required_size);
 #endif
 
+    vkd3d_il2_baked_cache_trace_create("placed", object, heap_offset);
     *resource = object;
     return S_OK;
 
@@ -7069,6 +7148,23 @@ static bool vkd3d_setup_texture_srv_view(struct d3d12_device *device,
         texture->miplevel_count = resource->desc.MipLevels - texture->miplevel_idx;
 
     vkd3d_texture_view_desc_fixup(device, texture);
+
+    if (vkd3d_il2_baked_cache_trace_resource(resource))
+    {
+        uint32_t sequence;
+
+        if (vkd3d_il2_baked_cache_trace_take(VKD3D_IL2_BAKED_CACHE_TRACE_SRV, &sequence))
+        {
+            INFO("IL2CACHE srv seq=%u cookie=%u resource_format=%#x view_format=%#x"
+                    " view_dimension=%u first_mip=%u mip_count=%u min_lod=%f"
+                    " first_layer=%u layer_count=%u view_type=%u common_layout=%u.\n",
+                    sequence, resource->res.cookie.index, resource->desc.Format,
+                    desc ? desc->Format : 0, desc ? desc->ViewDimension : 0,
+                    texture->miplevel_idx, texture->miplevel_count, texture->miplevel_clamp,
+                    texture->layer_idx, texture->layer_count, texture->view_type,
+                    resource->common_layout);
+        }
+    }
     return true;
 }
 
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 03262ed7..48f0a408 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -1234,6 +1234,20 @@ HRESULT d3d12_resource_validate_heap_properties(const D3D12_RESOURCE_DESC1 *desc
 struct vkd3d_cookie vkd3d_allocate_cookie(void);
 UINT vkd3d_allocate_cookie_va_timestamp(void);
 
+enum vkd3d_il2_baked_cache_trace_event
+{
+    VKD3D_IL2_BAKED_CACHE_TRACE_CREATE,
+    VKD3D_IL2_BAKED_CACHE_TRACE_SRV,
+    VKD3D_IL2_BAKED_CACHE_TRACE_COPY,
+    VKD3D_IL2_BAKED_CACHE_TRACE_BARRIER,
+    VKD3D_IL2_BAKED_CACHE_TRACE_DESTROY,
+    VKD3D_IL2_BAKED_CACHE_TRACE_EVENT_COUNT,
+};
+
+bool vkd3d_il2_baked_cache_trace_enabled(void);
+bool vkd3d_il2_baked_cache_trace_take(enum vkd3d_il2_baked_cache_trace_event event, uint32_t *sequence);
+bool vkd3d_il2_baked_cache_trace_resource(const struct d3d12_resource *resource);
+
 static inline struct vkd3d_cookie vkd3d_null_cookie(void)
 {
     struct vkd3d_cookie cookie = { 0 };
-- 
2.55.0

