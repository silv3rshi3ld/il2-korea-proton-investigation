From f6416c79dafabcb76e2e095935dfcd0c428b9208 Mon Sep 17 00:00:00 2001
From: Silv3rShi3ld <silv3rshi3ld@users.noreply.github.com>
Date: Thu, 6 Aug 2026 22:27:48 +0200
Subject: [PATCH] vkd3d: Handle footprint-only IL-2 BC3 border copies

---
 libs/vkd3d/command.c | 104 ++++++++++++++++++++++++++++++++-----------
 1 file changed, 78 insertions(+), 26 deletions(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 4a2c3b7c..9569df15 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -9649,12 +9649,14 @@ static bool vkd3d_il2_normalize_bc3_border_copy(VkBufferImageCopy2 *copy,
         const struct vkd3d_format *src_format, const struct vkd3d_format *dst_format,
         const D3D12_BOX *src_box, uint32_t dst_cookie, D3D12_COMMAND_LIST_TYPE list_type)
 {
+    static uint32_t candidate_count;
     static uint32_t adjustment_count;
-    uint32_t original_width, original_height;
-    uint32_t sequence;
+    uint32_t original_width, original_height, emitted_width, emitted_height;
+    uint32_t source_left, source_top, source_front, source_width, source_height, source_depth;
+    uint32_t candidate_sequence, sequence, reject_mask = 0;
     bool horizontal, vertical;
 
-    if (!vkd3d_il2_bc3_border_copy_diagnostic_enabled() || !src_box)
+    if (!vkd3d_il2_bc3_border_copy_diagnostic_enabled())
         return false;
 
     /* This is deliberately narrower than a compatibility implementation. It
@@ -9664,19 +9666,11 @@ static bool vkd3d_il2_normalize_bc3_border_copy(VkBufferImageCopy2 *copy,
             image_desc->Width != 2048 || image_desc->Height != 2048 ||
             image_desc->DepthOrArraySize != 1 || image_desc->MipLevels != 1 ||
             image_desc->Format != DXGI_FORMAT_BC3_UNORM ||
-            src_format->dxgi_format != DXGI_FORMAT_BC3_UNORM ||
             dst_format->dxgi_format != DXGI_FORMAT_BC3_UNORM ||
-            src_format->block_width != 4 || src_format->block_height != 4 ||
             dst_format->block_width != 4 || dst_format->block_height != 4 ||
-            src_format->byte_count * src_format->block_byte_count !=
-                    dst_format->byte_count * dst_format->block_byte_count ||
-            footprint->Footprint.Depth != 1 ||
-            footprint->Footprint.RowPitch < src_format->byte_count * src_format->block_byte_count ||
             copy->imageSubresource.mipLevel != 0 || copy->imageSubresource.layerCount != 1 ||
             copy->imageOffset.x < 0 || copy->imageOffset.y < 0 || copy->imageOffset.z != 0 ||
-            copy->imageOffset.x % 4 || copy->imageOffset.y % 4 ||
-            src_box->left % 4 || src_box->top % 4 || src_box->front != 0 ||
-            src_box->back - src_box->front != 1 || copy->imageExtent.depth != 1)
+            copy->imageOffset.x % 4 || copy->imageOffset.y % 4 || copy->imageExtent.depth != 1)
         return false;
 
     original_width = copy->imageExtent.width;
@@ -9686,34 +9680,92 @@ static bool vkd3d_il2_normalize_bc3_border_copy(VkBufferImageCopy2 *copy,
     if (!vertical && !horizontal)
         return false;
 
-    if (vertical)
+    emitted_width = vertical ? dst_format->block_width : original_width;
+    emitted_height = horizontal ? dst_format->block_height : original_height;
+    if ((uint32_t)copy->imageOffset.x + emitted_width > image_desc->Width ||
+            (uint32_t)copy->imageOffset.y + emitted_height > image_desc->Height)
+        return false;
+
+    if (src_box)
     {
-        if ((uint32_t)copy->imageOffset.x + src_format->block_width > image_desc->Width)
-            return false;
-        copy->imageExtent.width = src_format->block_width;
+        source_left = src_box->left;
+        source_top = src_box->top;
+        source_front = src_box->front;
+        source_width = src_box->right - src_box->left;
+        source_height = src_box->bottom - src_box->top;
+        source_depth = src_box->back - src_box->front;
     }
     else
     {
-        if ((uint32_t)copy->imageOffset.y + src_format->block_height > image_desc->Height)
-            return false;
-        copy->imageExtent.height = src_format->block_height;
+        source_left = 0;
+        source_top = 0;
+        source_front = 0;
+        source_width = footprint->Footprint.Width;
+        source_height = footprint->Footprint.Height;
+        source_depth = footprint->Footprint.Depth;
+    }
+
+    candidate_sequence = vkd3d_atomic_uint32_increment(&candidate_count, vkd3d_memory_order_relaxed);
+    if (candidate_sequence <= VKD3D_IL2_BC3_BORDER_COPY_LOG_LIMIT)
+    {
+        INFO("IL2BCCOPY candidate seq=%u list_type=%u dst_cookie=%u src_box_present=%u"
+                " src_format=%#x dst_format=%#x original_extent=%ux%ux%u image_offset=%d,%d,%d"
+                " source_origin=%u,%u,%u source_extent=%ux%ux%u footprint=%ux%ux%u"
+                " row_pitch=%u buffer_row_length=%u buffer_image_height=%u buffer_offset=%"PRIu64".\n",
+                candidate_sequence, list_type, dst_cookie, !!src_box,
+                src_format->dxgi_format, dst_format->dxgi_format,
+                original_width, original_height, copy->imageExtent.depth,
+                copy->imageOffset.x, copy->imageOffset.y, copy->imageOffset.z,
+                source_left, source_top, source_front, source_width, source_height, source_depth,
+                footprint->Footprint.Width, footprint->Footprint.Height, footprint->Footprint.Depth,
+                footprint->Footprint.RowPitch, copy->bufferRowLength, copy->bufferImageHeight,
+                copy->bufferOffset);
+    }
+
+    if (src_format->block_width != 4 || src_format->block_height != 4)
+        reject_mask |= 0x1;
+    if (src_format->byte_count * src_format->block_byte_count !=
+            dst_format->byte_count * dst_format->block_byte_count)
+        reject_mask |= 0x2;
+    if (footprint->Footprint.Depth != 1 || source_depth != 1)
+        reject_mask |= 0x4;
+    if (source_left % 4 || source_top % 4 || source_front != 0)
+        reject_mask |= 0x8;
+    if (source_width < original_width || source_height < original_height)
+        reject_mask |= 0x10;
+    if (copy->bufferRowLength < emitted_width)
+        reject_mask |= 0x20;
+    if (copy->bufferImageHeight < emitted_height)
+        reject_mask |= 0x40;
+    if (footprint->Footprint.RowPitch < src_format->byte_count * src_format->block_byte_count)
+        reject_mask |= 0x80;
+
+    if (reject_mask)
+    {
+        if (candidate_sequence <= VKD3D_IL2_BC3_BORDER_COPY_LOG_LIMIT)
+            INFO("IL2BCCOPY reject candidate_seq=%u mask=%#x.\n", candidate_sequence, reject_mask);
+        return false;
     }
 
+    copy->imageExtent.width = emitted_width;
+    copy->imageExtent.height = emitted_height;
     sequence = vkd3d_atomic_uint32_increment(&adjustment_count, vkd3d_memory_order_relaxed);
     if (sequence <= VKD3D_IL2_BC3_BORDER_COPY_LOG_LIMIT)
     {
-        INFO("IL2BCCOPY adjust seq=%u list_type=%u dst_cookie=%u"
+        INFO("IL2BCCOPY adjust seq=%u candidate_seq=%u list_type=%u dst_cookie=%u src_box_present=%u"
+                " src_format=%#x dst_format=%#x"
                 " original_extent=%ux%ux%u emitted_extent=%ux%ux%u image_offset=%d,%d,%d"
-                " src_box=%u,%u,%u-%u,%u,%u footprint=%ux%ux%u row_pitch=%u"
-                " buffer_offset=%"PRIu64".\n",
-                sequence, list_type, dst_cookie,
+                " source_origin=%u,%u,%u source_extent=%ux%ux%u footprint=%ux%ux%u row_pitch=%u"
+                " buffer_row_length=%u buffer_image_height=%u buffer_offset=%"PRIu64".\n",
+                sequence, candidate_sequence, list_type, dst_cookie, !!src_box,
+                src_format->dxgi_format, dst_format->dxgi_format,
                 original_width, original_height, copy->imageExtent.depth,
                 copy->imageExtent.width, copy->imageExtent.height, copy->imageExtent.depth,
                 copy->imageOffset.x, copy->imageOffset.y, copy->imageOffset.z,
-                src_box->left, src_box->top, src_box->front,
-                src_box->right, src_box->bottom, src_box->back,
+                source_left, source_top, source_front, source_width, source_height, source_depth,
                 footprint->Footprint.Width, footprint->Footprint.Height, footprint->Footprint.Depth,
-                footprint->Footprint.RowPitch, copy->bufferOffset);
+                footprint->Footprint.RowPitch, copy->bufferRowLength, copy->bufferImageHeight,
+                copy->bufferOffset);
     }
     else if (sequence == VKD3D_IL2_BC3_BORDER_COPY_LOG_LIMIT + 1)
     {
-- 
2.55.0

