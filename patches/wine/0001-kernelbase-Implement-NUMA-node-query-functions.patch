+static void test_numa_information(void)
+{
+    SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *info, *entry;
+    GROUP_AFFINITY affinity;
+    ULONG highest, expected_highest = 0;
+    DWORD offset, len = 0;
+    BOOL ret;
+
+    if (!pGetNumaHighestNodeNumber || !pGetNumaNodeProcessorMaskEx ||
+        !pGetLogicalProcessorInformationEx)
+    {
+        win_skip("NUMA topology functions are not supported\n");
+        return;
+    }
+
+    ret = pGetLogicalProcessorInformationEx(RelationNumaNode, NULL, &len);
+    ok(!ret && GetLastError() == ERROR_INSUFFICIENT_BUFFER,
+       "got %d, error %ld\n", ret, GetLastError());
+    ok(len > 0, "got length %lu\n", len);
+    if (!len) return;
+
+    info = calloc(len, 1);
+    ret = pGetLogicalProcessorInformationEx(RelationNumaNode, info, &len);
+    ok(ret, "got %d, error %ld\n", ret, GetLastError());
+    if (!ret)
+    {
+        free(info);
+        return;
+    }
+
+    for (offset = 0; offset < len; offset += entry->Size)
+    {
+        entry = (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *)((char *)info + offset);
+        ok(entry->Relationship == RelationNumaNode, "got relationship %u\n", entry->Relationship);
+        if (entry->NumaNode.NodeNumber > expected_highest)
+            expected_highest = entry->NumaNode.NodeNumber;
+
+        memset(&affinity, 0xcc, sizeof(affinity));
+        ret = pGetNumaNodeProcessorMaskEx(entry->NumaNode.NodeNumber, &affinity);
+        ok(ret, "node %lu: got %d, error %ld\n", entry->NumaNode.NodeNumber, ret, GetLastError());
+        if (ret)
+        {
+            ok(affinity.Mask == entry->NumaNode.GroupMask.Mask,
+               "node %lu: got mask %#Ix, expected %#Ix\n", entry->NumaNode.NodeNumber,
+               affinity.Mask, entry->NumaNode.GroupMask.Mask);
+            ok(affinity.Group == entry->NumaNode.GroupMask.Group,
+               "node %lu: got group %u, expected %u\n", entry->NumaNode.NodeNumber,
+               affinity.Group, entry->NumaNode.GroupMask.Group);
+        }
+    }
+
+    highest = ~0u;
+    ret = pGetNumaHighestNodeNumber(&highest);
+    ok(ret, "got %d, error %ld\n", ret, GetLastError());
+    ok(highest == expected_highest, "got highest node %lu, expected %lu\n",
+       highest, expected_highest);
+    free(info);
+}
