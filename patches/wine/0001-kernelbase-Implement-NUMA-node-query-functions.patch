+    SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *info, *entry;
+    ULONG offset, len;
+
+    if (!(info = get_numa_information( &len ))) return FALSE;
+
     *node = 0;
+    for (offset = 0; offset < len; offset += entry->Size)
+    {
+        entry = (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *)((char *)info + offset);
+        if (entry->NumaNode.NodeNumber > *node) *node = entry->NumaNode.NodeNumber;
+    }
+
+    HeapFree( GetProcessHeap(), 0, info );
     return TRUE;
 }
 
@@ -1590,8 +1631,22 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetNumaHighestNodeNumber( ULONG *node )
