+    alignment = device->device_info.vulkan_1_3_properties.storageTexelBufferOffsetAlignmentBytes;
+    if (device->device_info.vulkan_1_3_properties.storageTexelBufferOffsetSingleTexelAlignment)
+        alignment = min(alignment, sizeof(uint32_t));
+    alignment = max(alignment, 1);
+
+    if (!device->workarounds.typed_uav_r32_uint_alias || resource->desc.Width != 87040 || counter_resource ||
+            desc->ViewDimension != D3D12_UAV_DIMENSION_BUFFER || desc->Format != DXGI_FORMAT_R16_UINT ||
+            desc->Buffer.FirstElement != 0 || desc->Buffer.NumElements != 43520 ||
+            desc->Buffer.StructureByteStride || desc->Buffer.CounterOffsetInBytes ||
+            desc->Buffer.Flags != D3D12_BUFFER_UAV_FLAG_NONE || view->range != 87040 || view->va % alignment)
