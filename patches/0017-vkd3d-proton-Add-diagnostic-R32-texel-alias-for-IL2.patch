+static inline bool d3d12_device_supports_typed_uav_r32_uint_alias(const struct d3d12_device *device)
+{
+    const VkPhysicalDeviceDescriptorBufferPropertiesEXT *properties =
+            &device->device_info.descriptor_buffer_properties;
+    uint32_t payload_limit;
+
+    payload_limit = device->bindless_state.flags & VKD3D_BINDLESS_MUTABLE_EMBEDDED_PACKED_METADATA
+            ? device->bindless_state.packed_metadata_offset
+            : device->bindless_state.cbv_srv_uav_size;
+
+    return d3d12_device_use_embedded_mutable_descriptors(device) &&
+            !d3d12_device_use_descriptor_heap(device) &&
+            (device->bindless_state.flags & VKD3D_BINDLESS_RAW_SSBO) &&
+            device->bindless_state.packed_raw_buffer_offset &&
+            device->bindless_state.packed_raw_buffer_offset +
+                    properties->robustStorageTexelBufferDescriptorSize <=
+                    payload_limit;
+}
