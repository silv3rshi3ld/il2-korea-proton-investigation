From e7f6e30381aece36ad2d8ed86b18b011af191a17 Mon Sep 17 00:00:00 2001
From: Silv3rShi3ld <silv3rshi3ld@users.noreply.github.com>
Date: Fri, 7 Aug 2026 21:05:20 +0200
Subject: [PATCH 11/13] vkd3d: Trace named menu reflection resource usage

---
 libs/vkd3d/command.c       | 208 +++++++++++++++++++++++++++++++++++++
 libs/vkd3d/resource.c      |  21 ++++
 libs/vkd3d/vkd3d_private.h |   4 +
 3 files changed, 233 insertions(+)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index ef417b70..4f577aaf 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -29,10 +29,14 @@
 #endif

 #define VKD3D_IL2_MENU_PIX_EVENT_LIMIT 50000u
+#define VKD3D_IL2_MENU_USAGE_EVENT_LIMIT 100000u

 static pthread_once_t vkd3d_il2_menu_command_trace_once = PTHREAD_ONCE_INIT;
 static bool vkd3d_il2_menu_command_trace;
 static uint32_t vkd3d_il2_menu_pix_event_count;
+static pthread_once_t vkd3d_il2_menu_usage_trace_once = PTHREAD_ONCE_INIT;
+static bool vkd3d_il2_menu_usage_trace;
+static uint32_t vkd3d_il2_menu_usage_event_count;

 static void vkd3d_il2_menu_command_trace_init(void)
 {
@@ -63,6 +67,167 @@ static bool vkd3d_il2_menu_command_trace_take(uint32_t *sequence)
     return false;
 }

+static void vkd3d_il2_menu_usage_trace_init(void)
+{
+    char value[16];
+
+    vkd3d_il2_menu_usage_trace = vkd3d_get_env_var("VKD3D_IL2_MENU_TRACE", value, sizeof(value)) &&
+            strcmp(value, "0") != 0;
+    if (vkd3d_il2_menu_usage_trace)
+        INFO("IL2MENU usage trace enabled; limit=%u.\n", VKD3D_IL2_MENU_USAGE_EVENT_LIMIT);
+}
+
+static bool vkd3d_il2_menu_usage_trace_take(struct d3d12_command_list *list, uint32_t *sequence)
+{
+    uint32_t value;
+
+    pthread_once(&vkd3d_il2_menu_usage_trace_once, vkd3d_il2_menu_usage_trace_init);
+    if (!vkd3d_il2_menu_usage_trace)
+        return false;
+
+    value = vkd3d_atomic_uint32_increment(&vkd3d_il2_menu_usage_event_count,
+            vkd3d_memory_order_relaxed);
+    *sequence = value;
+    if (value <= VKD3D_IL2_MENU_USAGE_EVENT_LIMIT)
+    {
+        if (list)
+            list->il2_menu_trace_has_tracked_event = true;
+        return true;
+    }
+
+    if (value == VKD3D_IL2_MENU_USAGE_EVENT_LIMIT + 1)
+        INFO("IL2MENU usage events suppressed after limit=%u.\n", VKD3D_IL2_MENU_USAGE_EVENT_LIMIT);
+    return false;
+}
+
+static bool vkd3d_il2_menu_resource_is_tracked(const struct d3d12_resource *resource)
+{
+    return resource && resource->il2_menu_trace_tracked;
+}
+
+static void vkd3d_il2_menu_trace_barrier(struct d3d12_command_list *list,
+        const D3D12_RESOURCE_BARRIER *barrier)
+{
+    struct d3d12_resource *before_resource, *after_resource, *resource;
+    uint32_t sequence;
+
+    switch (barrier->Type)
+    {
+        case D3D12_RESOURCE_BARRIER_TYPE_TRANSITION:
+            resource = impl_from_ID3D12Resource(barrier->Transition.pResource);
+            if (vkd3d_il2_menu_resource_is_tracked(resource) &&
+                    vkd3d_il2_menu_usage_trace_take(list, &sequence))
+            {
+                INFO("IL2MENU usage sequence=%u op=barrier list=%p cookie=%u name=%s flags=%#x "
+                        "subresource=%u before=%#x after=%#x.\n", sequence, list,
+                        resource->res.cookie.index, resource->il2_menu_trace_name, barrier->Flags,
+                        barrier->Transition.Subresource, barrier->Transition.StateBefore,
+                        barrier->Transition.StateAfter);
+            }
+            break;
+
+        case D3D12_RESOURCE_BARRIER_TYPE_UAV:
+            resource = impl_from_ID3D12Resource(barrier->UAV.pResource);
+            if (vkd3d_il2_menu_resource_is_tracked(resource) &&
+                    vkd3d_il2_menu_usage_trace_take(list, &sequence))
+            {
+                INFO("IL2MENU usage sequence=%u op=uav_barrier list=%p cookie=%u name=%s flags=%#x.\n",
+                        sequence, list, resource->res.cookie.index,
+                        resource->il2_menu_trace_name, barrier->Flags);
+            }
+            break;
+
+        case D3D12_RESOURCE_BARRIER_TYPE_ALIASING:
+            before_resource = impl_from_ID3D12Resource(barrier->Aliasing.pResourceBefore);
+            after_resource = impl_from_ID3D12Resource(barrier->Aliasing.pResourceAfter);
+            if ((vkd3d_il2_menu_resource_is_tracked(before_resource) ||
+                    vkd3d_il2_menu_resource_is_tracked(after_resource)) &&
+                    vkd3d_il2_menu_usage_trace_take(list, &sequence))
+            {
+                INFO("IL2MENU usage sequence=%u op=alias_barrier list=%p before_cookie=%u "
+                        "before_name=%s after_cookie=%u after_name=%s flags=%#x.\n", sequence, list,
+                        before_resource ? before_resource->res.cookie.index : 0,
+                        vkd3d_il2_menu_resource_is_tracked(before_resource) ?
+                                before_resource->il2_menu_trace_name : "-",
+                        after_resource ? after_resource->res.cookie.index : 0,
+                        vkd3d_il2_menu_resource_is_tracked(after_resource) ?
+                                after_resource->il2_menu_trace_name : "-", barrier->Flags);
+            }
+            break;
+    }
+}
+
+static void vkd3d_il2_menu_trace_rtv_bind(struct d3d12_command_list *list,
+        const struct d3d12_rtv_desc *rtv_desc, unsigned int slot, const char *source)
+{
+    struct d3d12_resource *resource;
+    uint32_t sequence;
+
+    if (!rtv_desc || !vkd3d_il2_menu_resource_is_tracked(resource = rtv_desc->resource) ||
+            !vkd3d_il2_menu_usage_trace_take(list, &sequence))
+        return;
+
+    INFO("IL2MENU usage sequence=%u op=rtv_bind source=%s list=%p slot=%u cookie=%u "
+            "view_cookie=%u name=%s.\n", sequence, source, list, slot,
+            resource->res.cookie.index, rtv_desc->view->cookie.index,
+            resource->il2_menu_trace_name);
+}
+
+static void vkd3d_il2_menu_trace_draw(struct d3d12_command_list *list, const char *op,
+        uint32_t element_count, uint32_t instance_count)
+{
+    uint64_t vs_hash = 0, ps_hash = 0;
+    unsigned int i, slot;
+    uint32_t sequence;
+
+    if (list->state && d3d12_pipeline_state_is_graphics(list->state))
+    {
+        for (i = 0; i < list->state->graphics.stage_count; i++)
+        {
+            if (list->state->graphics.stages[i].stage == VK_SHADER_STAGE_VERTEX_BIT)
+                vs_hash = list->state->graphics.code[i].meta.hash;
+            else if (list->state->graphics.stages[i].stage == VK_SHADER_STAGE_FRAGMENT_BIT)
+                ps_hash = list->state->graphics.code[i].meta.hash;
+        }
+    }
+
+    for (slot = 0; slot < ARRAY_SIZE(list->rtvs); slot++)
+    {
+        const struct d3d12_rtv_desc *rtv_desc = &list->rtvs[slot];
+        struct d3d12_resource *resource = rtv_desc->resource;
+
+        if (!vkd3d_il2_menu_resource_is_tracked(resource) ||
+                !vkd3d_il2_menu_usage_trace_take(list, &sequence))
+            continue;
+
+        INFO("IL2MENU usage sequence=%u op=%s list=%p slot=%u cookie=%u name=%s "
+                "elements=%u instances=%u vs=%016"PRIx64" ps=%016"PRIx64".\n",
+                sequence, op, list, slot, resource->res.cookie.index,
+                resource->il2_menu_trace_name, element_count, instance_count,
+                vs_hash, ps_hash);
+    }
+}
+
+static void vkd3d_il2_menu_trace_copy(struct d3d12_command_list *list, const char *op,
+        struct d3d12_resource *dst_resource, struct d3d12_resource *src_resource)
+{
+    uint32_t sequence;
+
+    if ((!vkd3d_il2_menu_resource_is_tracked(dst_resource) &&
+            !vkd3d_il2_menu_resource_is_tracked(src_resource)) ||
+            !vkd3d_il2_menu_usage_trace_take(list, &sequence))
+        return;
+
+    INFO("IL2MENU usage sequence=%u op=%s list=%p dst_cookie=%u dst_name=%s "
+            "src_cookie=%u src_name=%s.\n", sequence, op, list,
+            dst_resource ? dst_resource->res.cookie.index : 0,
+            vkd3d_il2_menu_resource_is_tracked(dst_resource) ?
+                    dst_resource->il2_menu_trace_name : "-",
+            src_resource ? src_resource->res.cookie.index : 0,
+            vkd3d_il2_menu_resource_is_tracked(src_resource) ?
+                    src_resource->il2_menu_trace_name : "-");
+}
+
 static HRESULT d3d12_fence_signal(struct d3d12_fence *fence, struct vkd3d_fence_worker *worker, uint64_t value);
 static void d3d12_command_queue_add_submission(struct d3d12_command_queue *queue,
         const struct d3d12_command_queue_submission *sub);
@@ -7284,6 +7449,7 @@ static void d3d12_command_list_reset_api_state(struct d3d12_command_list *list,

     list->is_inside_render_pass = false;
     list->render_pass_flags = 0;
+    list->il2_menu_trace_has_tracked_event = false;
     memset(list->rtvs, 0, sizeof(list->rtvs));
     memset(&list->dsv, 0, sizeof(list->dsv));
     d3d12_command_list_reset_rtv_resolves(list);
@@ -9311,6 +9477,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_DrawInstanced(d3d12_command_lis
         return;
     }

+    vkd3d_il2_menu_trace_draw(list, "draw", vertex_count_per_instance, instance_count);
+
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_HIGH;

     if (!list->predication.fallback_enabled)
@@ -9384,6 +9552,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_DrawIndexedInstanced(d3d12_comm
         return;
     }

+    vkd3d_il2_menu_trace_draw(list, "draw_indexed", index_count_per_instance, instance_count);
+
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_HIGH;

     d3d12_command_list_check_index_buffer_strip_cut_value(list);
@@ -10919,6 +11089,10 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyTextureRegion(d3d12_command
     if (!d3d12_command_list_init_copy_texture_region(list, dst, dst_x, dst_y, dst_z, src, src_box, &copy_info))
         return;

+    vkd3d_il2_menu_trace_copy(list, "copy_texture",
+            impl_from_ID3D12Resource(copy_info.dst.pResource),
+            impl_from_ID3D12Resource(copy_info.src.pResource));
+
     d3d12_command_list_ensure_transfer_batch(list, copy_info.batch_type);

     list->cmd.estimated_cost += VKD3D_COMMAND_COST_LOW;
@@ -11016,6 +11190,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyResource(d3d12_command_list
     dst_resource = impl_from_ID3D12Resource(dst);
     src_resource = impl_from_ID3D12Resource(src);

+    vkd3d_il2_menu_trace_copy(list, "copy_resource", dst_resource, src_resource);
+
     if (list->type == D3D12_COMMAND_LIST_TYPE_COPY)
     {
         if (!(dst_resource->flags & VKD3D_RESOURCE_COPY_QUEUE_COMPATIBLE) ||
@@ -13600,6 +13776,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_ResourceBarrier(d3d12_command_l
         const D3D12_RESOURCE_BARRIER *current = &barriers[i];
         struct d3d12_resource *preserve_resource = NULL;

+        vkd3d_il2_menu_trace_barrier(list, current);
+
         have_split_barriers = have_split_barriers
                 || (current->Flags & D3D12_RESOURCE_BARRIER_FLAG_BEGIN_ONLY)
                 || (current->Flags & D3D12_RESOURCE_BARRIER_FLAG_END_ONLY);
@@ -14954,6 +15132,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_OMSetRenderTargets(d3d12_comman
             continue;
         }

+        vkd3d_il2_menu_trace_rtv_bind(list, rtv_desc, i, "om_set");
+
         VKD3D_BREADCRUMB_COOKIE(rtv_desc->view->cookie.index);
         VKD3D_BREADCRUMB_AUX32(i);
         VKD3D_BREADCRUMB_TAG("RTV bind");
@@ -15412,6 +15592,19 @@ static void STDMETHODCALLTYPE d3d12_command_list_ClearRenderTargetView(d3d12_com
         copy_and_clamp_clear_color(rtv_desc->format->vk_format, clear_value.color.float32, color);
     }

+    if (vkd3d_il2_menu_resource_is_tracked(rtv_desc->resource))
+    {
+        uint32_t sequence;
+
+        if (vkd3d_il2_menu_usage_trace_take(list, &sequence))
+        {
+            INFO("IL2MENU usage sequence=%u op=rtv_clear list=%p cookie=%u name=%s "
+                    "color=%f,%f,%f,%f rect_count=%u.\n", sequence, list,
+                    rtv_desc->resource->res.cookie.index, rtv_desc->resource->il2_menu_trace_name,
+                    color[0], color[1], color[2], color[3], rect_count);
+        }
+    }
+
     d3d12_command_list_clear_attachment(list, rtv_desc->resource, rtv_desc->view,
             VK_IMAGE_ASPECT_COLOR_BIT, &clear_value, rect_count, rects);
 }
@@ -19990,6 +20183,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_BeginRenderPass(d3d12_command_l
             {
                 list->rtvs[rt_index] = *rtv_desc;

+                vkd3d_il2_menu_trace_rtv_bind(list, rtv_desc, rt_index, "begin_render_pass");
+
                 VKD3D_BREADCRUMB_COOKIE(rtv_desc->view->cookie.index);
                 VKD3D_BREADCRUMB_AUX32(i);
                 VKD3D_BREADCRUMB_TAG("RTV bind");
@@ -23110,6 +23305,19 @@ static void STDMETHODCALLTYPE d3d12_command_queue_ExecuteCommandLists(ID3D12Comm
             return;
         }

+        if (cmd_list->il2_menu_trace_has_tracked_event)
+        {
+            uint32_t sequence;
+
+            if (vkd3d_il2_menu_usage_trace_take(NULL, &sequence))
+            {
+                INFO("IL2MENU usage sequence=%u op=execute queue=%p list=%p index=%u "
+                        "list_count=%u type=%u iterations=%u.\n", sequence, command_queue,
+                        cmd_list, i, command_list_count, cmd_list->type,
+                        cmd_list->cmd.iteration_count);
+            }
+        }
+
         num_transitions += cmd_list->init_transitions_count;

         allocators[i] = cmd_list->submit_allocator;
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 244e1eba..4aa221ac 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -68,10 +68,31 @@ static bool vkd3d_il2_menu_resource_trace_take(uint32_t *sequence)
     return false;
 }

+static bool vkd3d_il2_menu_is_reflection_resource_name(const char *name)
+{
+    return !strcmp(name, "reflection_color") ||
+            !strcmp(name, "reflection_depth") ||
+            !strcmp(name, "m_rtRefEdges") ||
+            !strcmp(name, "m_rtRefTemp") ||
+            !strcmp(name, "rtCubeRefDownsampledBlur") ||
+            !strcmp(name, "rtTempSSR") ||
+            strstr(name, "rtSSR") == name ||
+            strstr(name, "SSRW") != NULL ||
+            strstr(name, "TargetReflections") != NULL ||
+            strstr(name, "ReflectionShadows") != NULL;
+}
+
 static void vkd3d_il2_menu_trace_resource_name(struct d3d12_resource *resource, const char *name)
 {
     uint32_t sequence;

+    pthread_once(&vkd3d_il2_menu_resource_trace_once, vkd3d_il2_menu_resource_trace_init);
+    if (vkd3d_il2_menu_resource_trace && vkd3d_il2_menu_is_reflection_resource_name(name))
+    {
+        resource->il2_menu_trace_tracked = true;
+        snprintf(resource->il2_menu_trace_name, sizeof(resource->il2_menu_trace_name), "%s", name);
+    }
+
     if (!vkd3d_il2_menu_resource_trace_take(&sequence))
         return;

diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 03262ed7..26813151 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -1202,6 +1202,9 @@ struct d3d12_resource

     struct vkd3d_private_store private_store;
     struct d3d_destruction_notifier destruction_notifier;
+
+    bool il2_menu_trace_tracked;
+    char il2_menu_trace_name[64];
 };

 static inline bool d3d12_resource_is_buffer(const struct d3d12_resource *resource)
@@ -3370,6 +3373,7 @@ struct d3d12_command_list
     bool is_valid;
     bool debug_capture;
     bool has_replaced_shaders;
+    bool il2_menu_trace_has_tracked_event;

     struct vkd3d_index_buffer index_buffer;
     struct vkd3d_dgc_batch dgc_batch;
--
2.55.0
