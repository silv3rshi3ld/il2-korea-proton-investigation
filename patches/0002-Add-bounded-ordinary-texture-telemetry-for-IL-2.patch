From 54797ad35d0dcd921f2e65a98121f2c6d98754a4 Mon Sep 17 00:00:00 2001
From: Silv3rShi3ld <silv3rshi3ld@users.noreply.github.com>
Date: Thu, 6 Aug 2026 19:28:55 +0200
Subject: [PATCH] Add bounded ordinary texture telemetry for IL-2

---
 libs/vkd3d/command.c       | 70 +++++++++++++++++++++++++++++
 libs/vkd3d/device.c        |  1 +
 libs/vkd3d/resource.c      | 91 ++++++++++++++++++++++++++++++++++++++
 libs/vkd3d/vkd3d_private.h | 12 +++++
 4 files changed, 174 insertions(+)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index f1f412ef..674525ee 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -10836,7 +10836,9 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyTextureRegion(d3d12_command
         const D3D12_TEXTURE_COPY_LOCATION *src, const D3D12_BOX *src_box)
 {
     struct d3d12_command_list *list = impl_from_ID3D12GraphicsCommandList(iface);
+    struct d3d12_resource *dst_resource, *src_resource;
     struct vkd3d_image_copy_info copy_info;
+    uint32_t sequence;
     VkImageCopy2 *fused_aspect_info;
     VkImageAspectFlags fused_aspect;
     bool alias;
@@ -10857,6 +10859,58 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyTextureRegion(d3d12_command
     if (!d3d12_command_list_init_copy_texture_region(list, dst, dst_x, dst_y, dst_z, src, src_box, &copy_info))
         return;
 
+    dst_resource = impl_from_ID3D12Resource(dst->pResource);
+    src_resource = impl_from_ID3D12Resource(src->pResource);
+
+    if (vkd3d_il2_texture_trace_take(VKD3D_IL2_TEXTURE_TRACE_COPY, &sequence))
+    {
+        if (copy_info.batch_type == VKD3D_BATCH_TYPE_COPY_IMAGE)
+        {
+            INFO("IL2TEX copy seq=%u batch=%u list_type=%u src_cookie=%u dst_cookie=%u"
+                    " src_location=%u dst_location=%u src_subresource=%u dst_subresource=%u"
+                    " src_mip=%u dst_mip=%u src_layer=%u dst_layer=%u layers=%u"
+                    " extent=%ux%ux%u src_offset=%d,%d,%d dst_offset=%d,%d,%d"
+                    " full_subresource=%u full_resource=%u overlap=%u.\n",
+                    sequence, copy_info.batch_type, list->type,
+                    src_resource->res.cookie.index, dst_resource->res.cookie.index,
+                    src->Type, dst->Type, src->SubresourceIndex, dst->SubresourceIndex,
+                    copy_info.copy.image.srcSubresource.mipLevel,
+                    copy_info.copy.image.dstSubresource.mipLevel,
+                    copy_info.copy.image.srcSubresource.baseArrayLayer,
+                    copy_info.copy.image.dstSubresource.baseArrayLayer,
+                    copy_info.copy.image.dstSubresource.layerCount,
+                    copy_info.copy.image.extent.width, copy_info.copy.image.extent.height,
+                    copy_info.copy.image.extent.depth,
+                    copy_info.copy.image.srcOffset.x, copy_info.copy.image.srcOffset.y,
+                    copy_info.copy.image.srcOffset.z, copy_info.copy.image.dstOffset.x,
+                    copy_info.copy.image.dstOffset.y, copy_info.copy.image.dstOffset.z,
+                    copy_info.writes_full_subresource, copy_info.writes_full_resource,
+                    copy_info.overlapping_subresource);
+        }
+        else
+        {
+            INFO("IL2TEX copy seq=%u batch=%u list_type=%u src_cookie=%u dst_cookie=%u"
+                    " src_location=%u dst_location=%u src_subresource=%u dst_subresource=%u"
+                    " image_mip=%u image_layer=%u layers=%u extent=%ux%ux%u"
+                    " image_offset=%d,%d,%d buffer_offset=%"PRIu64" footprint_size=%"PRIu64
+                    " full_subresource=%u full_resource=%u.\n",
+                    sequence, copy_info.batch_type, list->type,
+                    src_resource->res.cookie.index, dst_resource->res.cookie.index,
+                    src->Type, dst->Type, src->SubresourceIndex, dst->SubresourceIndex,
+                    copy_info.copy.buffer_image.imageSubresource.mipLevel,
+                    copy_info.copy.buffer_image.imageSubresource.baseArrayLayer,
+                    copy_info.copy.buffer_image.imageSubresource.layerCount,
+                    copy_info.copy.buffer_image.imageExtent.width,
+                    copy_info.copy.buffer_image.imageExtent.height,
+                    copy_info.copy.buffer_image.imageExtent.depth,
+                    copy_info.copy.buffer_image.imageOffset.x,
+                    copy_info.copy.buffer_image.imageOffset.y,
+                    copy_info.copy.buffer_image.imageOffset.z,
+                    copy_info.copy.buffer_image.bufferOffset, copy_info.buffer_footprint_size,
+                    copy_info.writes_full_subresource, copy_info.writes_full_resource);
+        }
+    }
+
     d3d12_command_list_ensure_transfer_batch(list, copy_info.batch_type);
 
     list->cmd.estimated_cost += VKD3D_COMMAND_COST_LOW;
@@ -10939,6 +10993,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyResource(d3d12_command_list
     unsigned int subresource_idx;
     VkCopyBufferInfo2 copy_info;
     VkImageCopy2 vk_image_copy;
+    uint32_t sequence;
     unsigned int layer_count;
     unsigned int level_count;
     unsigned int plane_count;
@@ -10954,6 +11009,21 @@ static void STDMETHODCALLTYPE d3d12_command_list_CopyResource(d3d12_command_list
     dst_resource = impl_from_ID3D12Resource(dst);
     src_resource = impl_from_ID3D12Resource(src);
 
+    if ((d3d12_resource_is_texture(src_resource) || d3d12_resource_is_texture(dst_resource)) &&
+            vkd3d_il2_texture_trace_take(VKD3D_IL2_TEXTURE_TRACE_COPY, &sequence))
+    {
+        INFO("IL2TEX copy_resource seq=%u list_type=%u src_cookie=%u dst_cookie=%u"
+                " src_dimension=%u dst_dimension=%u src_extent=%"PRIu64"x%ux%u"
+                " dst_extent=%"PRIu64"x%ux%u src_mips=%u dst_mips=%u"
+                " src_format=%#x dst_format=%#x.\n",
+                sequence, list->type, src_resource->res.cookie.index, dst_resource->res.cookie.index,
+                src_resource->desc.Dimension, dst_resource->desc.Dimension,
+                src_resource->desc.Width, src_resource->desc.Height, src_resource->desc.DepthOrArraySize,
+                dst_resource->desc.Width, dst_resource->desc.Height, dst_resource->desc.DepthOrArraySize,
+                src_resource->desc.MipLevels, dst_resource->desc.MipLevels,
+                src_resource->desc.Format, dst_resource->desc.Format);
+    }
+
     if (list->type == D3D12_COMMAND_LIST_TYPE_COPY)
     {
         if (!(dst_resource->flags & VKD3D_RESOURCE_COPY_QUEUE_COMPATIBLE) ||
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index bfb81f6e..98308949 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -34,6 +34,7 @@ static uint32_t vkd3d_get_vk_version(void)
     int major, minor, patch;
 
     (void)vkd3d_il2_resource_trace_enabled();
+    (void)vkd3d_il2_texture_trace_enabled();
     vkd3d_parse_version(PACKAGE_VERSION, &major, &minor, &patch);
     INFO("vkd3d-proton - applicationVersion: %d.%d.%d.\n", major, minor, patch);
     return VK_MAKE_VERSION(major, minor, patch);
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 9a9d05a2..0e626561 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -35,6 +35,13 @@ static UINT global_cookie_counter;
 static UINT global_cookie_va_timestamp;
 static pthread_once_t il2_resource_trace_once = PTHREAD_ONCE_INIT;
 static bool il2_resource_trace;
+static pthread_once_t il2_texture_trace_once = PTHREAD_ONCE_INIT;
+static bool il2_texture_trace;
+static uint32_t il2_texture_trace_counters[VKD3D_IL2_TEXTURE_TRACE_EVENT_COUNT];
+static const uint32_t il2_texture_trace_limits[VKD3D_IL2_TEXTURE_TRACE_EVENT_COUNT] =
+{
+    20000, 40000, 40000, 20000,
+};
 
 static void vkd3d_il2_resource_trace_init(void)
 {
@@ -52,6 +59,60 @@ bool vkd3d_il2_resource_trace_enabled(void)
     return il2_resource_trace;
 }
 
+static void vkd3d_il2_texture_trace_init(void)
+{
+    char value[16];
+
+    il2_texture_trace = vkd3d_get_env_var("VKD3D_IL2_TEXTURE_TRACE", value, sizeof(value)) &&
+            strcmp(value, "0") != 0;
+    if (il2_texture_trace)
+        INFO("IL2TEX enabled: bounded ordinary-texture, SRV-mip, copy, and lifetime telemetry.\n");
+}
+
+bool vkd3d_il2_texture_trace_enabled(void)
+{
+    pthread_once(&il2_texture_trace_once, vkd3d_il2_texture_trace_init);
+    return il2_texture_trace;
+}
+
+bool vkd3d_il2_texture_trace_take(enum vkd3d_il2_texture_trace_event event, uint32_t *sequence)
+{
+    uint32_t value;
+
+    if (!vkd3d_il2_texture_trace_enabled() || event >= VKD3D_IL2_TEXTURE_TRACE_EVENT_COUNT)
+        return false;
+
+    value = vkd3d_atomic_uint32_increment(&il2_texture_trace_counters[event], vkd3d_memory_order_relaxed);
+    *sequence = value;
+
+    if (value <= il2_texture_trace_limits[event])
+        return true;
+
+    if (value == il2_texture_trace_limits[event] + 1)
+        INFO("IL2TEX suppressed event=%u after limit=%u.\n", event, il2_texture_trace_limits[event]);
+
+    return false;
+}
+
+static void vkd3d_il2_texture_trace_resource_create(const char *allocation,
+        const struct d3d12_resource *resource, uint64_t heap_offset)
+{
+    uint32_t sequence;
+
+    if (!d3d12_resource_is_texture(resource) ||
+            !vkd3d_il2_texture_trace_take(VKD3D_IL2_TEXTURE_TRACE_CREATE, &sequence))
+        return;
+
+    INFO("IL2TEX create seq=%u cookie=%u allocation=%s dimension=%u width=%"PRIu64
+            " height=%u depth_or_layers=%u mips=%u format=%#x samples=%u heap_type=%u"
+            " heap_flags=%#x resource_flags=%#x layout=%u initial_state=%#x heap_offset=%"PRIu64".\n",
+            sequence, resource->res.cookie.index, allocation, resource->desc.Dimension,
+            resource->desc.Width, resource->desc.Height, resource->desc.DepthOrArraySize,
+            resource->desc.MipLevels, resource->desc.Format, resource->desc.SampleDesc.Count,
+            resource->heap_properties.Type, resource->heap_flags, resource->flags,
+            resource->common_layout, resource->initial_state, heap_offset);
+}
+
 static bool d3d12_resource_supports_small_resource_alignment(const D3D12_RESOURCE_DESC1 *desc,
         const struct vkd3d_format *format);
 
@@ -3991,6 +4052,17 @@ void d3d12_resource_decref_retained(struct d3d12_resource *resource)
 static void d3d12_resource_destroy(struct d3d12_resource *resource, struct d3d12_device *device)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    uint32_t sequence;
+
+    if (d3d12_resource_is_texture(resource) &&
+            vkd3d_il2_texture_trace_take(VKD3D_IL2_TEXTURE_TRACE_DESTROY, &sequence))
+    {
+        INFO("IL2TEX destroy seq=%u cookie=%u dimension=%u width=%"PRIu64
+                " height=%u depth_or_layers=%u mips=%u format=%#x resource_flags=%#x.\n",
+                sequence, resource->res.cookie.index, resource->desc.Dimension,
+                resource->desc.Width, resource->desc.Height, resource->desc.DepthOrArraySize,
+                resource->desc.MipLevels, resource->desc.Format, resource->flags);
+    }
 
     if (resource->flags & VKD3D_RESOURCE_RESERVED)
         d3d12_resource_wait_for_sparse_init(resource);
@@ -4564,6 +4636,8 @@ HRESULT d3d12_resource_create_committed(struct d3d12_device *device, const D3D12
     vkd3d_queue_timeline_trace_register_instantaneous(&device->queue_timeline_trace,
             VKD3D_QUEUE_TIMELINE_TRACE_STATE_TYPE_COMMITTED_RESOURCE_ALLOCATION, object->res.cookie.index);
 
+    vkd3d_il2_texture_trace_resource_create("committed", object, 0);
+
     *resource = object;
     return S_OK;
 
@@ -4802,6 +4876,8 @@ HRESULT d3d12_resource_create_placed(struct d3d12_device *device, const D3D12_RE
         vkd3d_breadcrumb_tracer_register_placed_resource(heap, object, heap_offset, required_size);
 #endif
 
+    vkd3d_il2_texture_trace_resource_create("placed", object, heap_offset);
+
     *resource = object;
     return S_OK;
 
@@ -7016,6 +7092,8 @@ static bool vkd3d_setup_texture_srv_view(struct d3d12_device *device,
         struct d3d12_resource *resource, const D3D12_SHADER_RESOURCE_VIEW_DESC *desc,
         struct vkd3d_texture_view_desc *texture)
 {
+    uint32_t sequence;
+
     if (!init_default_texture_view_desc(texture, resource, desc ? desc->Format : 0))
         return false;
 
@@ -7108,6 +7186,19 @@ static bool vkd3d_setup_texture_srv_view(struct d3d12_device *device,
         texture->miplevel_count = resource->desc.MipLevels - texture->miplevel_idx;
 
     vkd3d_texture_view_desc_fixup(device, texture);
+
+    if (vkd3d_il2_texture_trace_take(VKD3D_IL2_TEXTURE_TRACE_SRV, &sequence))
+    {
+        INFO("IL2TEX srv seq=%u cookie=%u dimension=%u view_dimension=%u resource_format=%#x"
+                " view_format=%#x width=%"PRIu64" height=%u depth_or_layers=%u resource_mips=%u"
+                " first_mip=%u mip_count=%u min_lod=%f first_layer=%u layer_count=%u view_type=%u.\n",
+                sequence, resource->res.cookie.index, resource->desc.Dimension,
+                desc ? desc->ViewDimension : 0, resource->desc.Format, desc ? desc->Format : 0,
+                resource->desc.Width, resource->desc.Height, resource->desc.DepthOrArraySize,
+                resource->desc.MipLevels, texture->miplevel_idx, texture->miplevel_count,
+                texture->miplevel_clamp, texture->layer_idx, texture->layer_count, texture->view_type);
+    }
+
     return true;
 }
 
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 27e6b074..66d2eebc 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -1235,6 +1235,18 @@ struct vkd3d_cookie vkd3d_allocate_cookie(void);
 UINT vkd3d_allocate_cookie_va_timestamp(void);
 bool vkd3d_il2_resource_trace_enabled(void);
 
+enum vkd3d_il2_texture_trace_event
+{
+    VKD3D_IL2_TEXTURE_TRACE_CREATE,
+    VKD3D_IL2_TEXTURE_TRACE_SRV,
+    VKD3D_IL2_TEXTURE_TRACE_COPY,
+    VKD3D_IL2_TEXTURE_TRACE_DESTROY,
+    VKD3D_IL2_TEXTURE_TRACE_EVENT_COUNT,
+};
+
+bool vkd3d_il2_texture_trace_enabled(void);
+bool vkd3d_il2_texture_trace_take(enum vkd3d_il2_texture_trace_event event, uint32_t *sequence);
+
 static inline struct vkd3d_cookie vkd3d_null_cookie(void)
 {
     struct vkd3d_cookie cookie = { 0 };
-- 
2.55.0

